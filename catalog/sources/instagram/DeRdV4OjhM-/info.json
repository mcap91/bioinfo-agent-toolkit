": "545919354", "id": "17944729662085043", "text": "Except in Doom you never see that effect", "timestamp": 1791884967, "like_count": 0}, {"author": "recognition_designs_ltd", "author_id": "976769966", "id": "18343755607286599", "text": "So you could make this in excel?\ud83d\ude02", "timestamp": 1791877203, "like_count": 0}, {"author": "psilosamples_info", "author_id": "22514571085", "id": "18184555369424208", "text": "Exactly", "timestamp": 1791822245, "like_count": 0}, {"author": "bhaswar.py", "author_id": "2392955061", "id": "18070616237784081", "text": "Cellular automata", "timestamp": 1791814963, "like_count": 0}, {"author": "pundarella", "author_id": "59159211350", "id": "17900944263604087", "text": "John Carmack\u2019s the goat", "timestamp": 1791803028, "like_count": 0}, {"author": "botaperna", "author_id": "66370834505", "id": "17881846545626075", "text": "This isn\u2019t even \u201cOG\u201d\nThis was in the PlayStation Version , not in the original", "timestamp": 1791796200, "like_count": 0}], "webpage_url": "https://www.instagram.com/reel/DeRdV4OjhM-/", "original_url": "https://www.instagram.com/reel/DeRdV4OjhM-/", "webpage_url_basename": "DeRdV4OjhM-", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "playlist": null, "playlist_index": null, "thumbnail": "https://scontent-sjc3-1.cdninstagram.com/v/t51.82787-15/836297681_18003845661006966_8282255991978981624_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=NDAwNDExMDU5MDU0MDY0OTI3OA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=mPBSo8GDrPAQ7kNvwHKgaI2&_nc_oc=Adpiw5gL9J1_SYVlWuoVKtkKvhg-50e4aY5GJEtxAq8ZqocNOnO-AOrPXG2kWY2jNGE&_nc_zt=23&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_gid=YurXAn24VsvzMe8GvB0pZg&_nc_ss=79689&oh=00_AQPvXCdKlekmVJ9spvacL8iVrA-rm64pd8S393pepMAHiA&oe=6AE606B9", "display_id": "DeRdV4OjhM-", "fulltitle": "Video by index.opensource", "uplo