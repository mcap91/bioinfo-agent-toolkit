{"id": "DeuiO0UjRLM", "title": "Video by candlesan", "description": "Make Your Game Feel Responsive by Breaking the Rules. Traditional animation rules divide an animation into three sections. The first \"Anticipation\" is great for adding weight, but can make a game feel less responsive. It's great for non-interactive media such as movies and television, as well as games where the wind-up animation is built into the gameplay. For games that want to optimize the responsiveness these rules sometimes need to be broken.  Jump animation credit: Andrew Coyle (https://cloytoons.wordpress.com/)\n\n#gamedesign", "channel": "candlesan", "uploader_id": "277997433", "uploader": "Wyatt Cheng", "timestamp": 1792522904, "like_count": 12398, "comment_count": 133, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.instagram.com/"}, "formats": [{"format_id": "dash-18628679305045434a", "manifest_url": null, "ext": "m4a", "width": null, "height": null, "tbr": 49.508, "asr": 48000, "fps": null, "language": null, "format_note": "DASH audio", "filesize": null, "container": "m4a_dash", "vcodec": "none", "acodec": "mp4a.40.5", "dynamic_range": null, "url": "https://scontent-sjc6-1.cdninstagram.com/o1/v/t2/f2/m78/AQNpRjtpqtMhNzF8pahcPiDI9mfPjdBz6s-Bot8pIGqrn0aMxarKlYT-oHSAPcG5qvZzndaWkD5MjuPwAO2EyN-Rv9FinvQ3JPTXEdc.mp4?_nc_cat=108&_nc_sid=9ca052&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_ohc=_0RL1TTL0S0Q7kNvwHTHQ2k&%3D&ccb=17-1&_nc_gid=muLIcsvODCWTmcz6k8H9VQ&_nc_ss=79689&_nc_zt=28&oh=00_AQS-KdKIx8HkGdq2eVeFs5wQlhImZ89gBfBfr6_AoAmC7w&oe=6AE49601", "manifest_stream_number": 0, "is_dash_periods": true, "protocol": "https", "audio_ext": "m4a", "video_ext": "none", "vbr": 0, "abr": 49.508, "resolution": "audio only", "aspect_ratio": null