yJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=ICx3L9avvSAQ7kNvwGEiPzG&_nc_oc=AdpOtqrSK-z-xqX4GUTqq1-pxxR46dotCp6Zvoq1-vFD2280UkgnHkdoTXzpzRFSOTY&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=iGWRf7ZWIOtgUSLJj1wXtA&_nc_ss=79689&oh=00_AQTsXNBsJnOKxiGPp6bOwnSRGuMhuReq7ffog5fJVHH9RA&oe=6AE8A21C", "width": 640, "height": 640, "id": "9", "resolution": "640x640"}, {"url": "https://scontent-sjc6-1.cdninstagram.com/v/t51.71878-15/829320101_1068112049165180_6210808989764728902_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=107&ig_cache_key=Mzk5NjQ3MTE0NTkyMDU0OTcwMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=ICx3L9avvSAQ7kNvwGEiPzG&_nc_oc=AdpOtqrSK-z-xqX4GUTqq1-pxxR46dotCp6Zvoq1-vFD2280UkgnHkdoTXzpzRFSOTY&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=iGWRf7ZWIOtgUSLJj1wXtA&_nc_ss=79689&oh=00_AQScCjdbUSumm6ZB_P4TS2wKc7PuvMJbCrxjitpbItQXhg&oe=6AE8A21C", "width": 640, "height": 1136, "id": "10", "resolution": "640x1136"}], "comments": [{"author": "super.intelligencee", "author_id": "11480017098", "id": "18100284119341415", "text": "The caching explanation is the key part, as reusing encodings for a stable action list is a neat way to gain speed without generating text.", "timestamp": 1792921939, "like_count": 1}, {"author": "llmplainly", "author_id": "72809967853", "id": "18110519285158478", "text": "if it never writes text, is it mostly for search and ranking stuff?", "timestamp": 1791839073, "like_count": 1}, {"author": "quantum_aidreams", "author_id": "56514263475", "id": "18120006565987573", "text": "This is the beginning of models similar to Jev. We\u2019ll see more like these in the near future.", "timestamp": 1791597169, "like_count": 1}, {"author": "caiovicentino", "author_id": "39464803", "id": "17971203402136231", "text": "Try Eikos 37b", "timestamp": 1790789508, "like_count": 0}, {"author": "mattkesby", "author_id": "55869105", "id": "17909911032519280", "text": "Great share", "timestamp": 1790774388, "like_count": 1}, {"author": "rohit.1993", "author_id": "1305647778", "id": "18145883989494473", "text": "Ye le, Mar gaya jev @vandan_panwala", "timestamp": 1790734961, "like_count": 0}, {"author": "datguylolzz", "author_id": "32352487718", "id": "17884552785623220", "text": "different things lol", "timestamp": 1790726902, "like_count": 0}, {"author": "constantin_ahrens", "author_id": "8224372544", "id": "18102941726626895", "text": "Good sir read the reports on it, it\u2019s good for large, stable, sets but becomes very slow and less accurate than jev when that isn\u2019t the case. It\u2019s not so much a Jev replacement as another tool for the arsenal because they fundamentally do different things.", "timestamp": 1790680037, "like_count": 1}, {"author": "ig_prenures", "author_id": "58469671153", "id": "18103912475198907", "text": "Holy manipulation \ud83d\ude2d", "timestamp": 1790674488, "like_count": 6}, {"author": "pani_puchki", "author_id": "52131839513", "id": "18106395662236582", "text": "\ud83d\ude4c", "timestamp": 1790670436, "like_count": 1}, {"author": "arnitly", "author_id": "78156213250", "id": "18126985630858671", "text": "Some comments are asking about how it compares to Laya:\n\nLaya runs on ModernBERT-large, which is just a 421M parameter encoder, so it's tiny compared to CLM. They claim about 8x faster than Jev on a single question and better calibration.\n\nCLM works differently. It uses two encoders on top of a frozen 8B Qwen3, embeds the state and every candidate action, and picks the closest match. Because actions are cached, it gets faster the more options you have. The catch here is that this assumes that every decision doesn\u2019t come with a new set of options (which CLM will have to encode again) and then Laya will likely be quicker.\n\nSo Laya is the lightweight drop-in for Jev's API, and CLM is the bigger model for ranking lots of actions. I couldn\u2019t find a head to head test between all 3.", "timestamp": 1790665759, "like_count": 7}, {"author": "arnitly", "author_id": "78156213250", "id": "18118624777978489", "text": "CLM Repo - https://github.com/Contrastive-LM/CLM", "timestamp": 1790665037, "like_count": 7}, {"author": "therealvamsi", "author_id": "2225746365", "id": "18000157928797903", "text": "This video doesn\u2019t help in proper understanding. I think you made the video very boring and poor by adding these technical words. Explain these words:\n\n1) State Encoder and Action Encoder\n2) Shared Embedding Space\n3) Highest co-ring action\n4) frozen encoded 8 billion parameter Qwen3\n5) Trainable projection head on top\n6) Synthetically generated hard negative examples.\n\nThese are terrible word jargon that you should avoid when you are posting a video on public platform. Be as general as possible so that even a non tech will understand your video.", "timestamp": 1790658378, "like_count": 1}, {"author": "volksbadmoebel", "author_id": "4447095362", "id": "18137488984628382", "text": "Thanks a lot\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f", "timestamp": 1790656314, "like_count": 2}, {"author": "_abhi_____sharma", "author_id": "39224784567", "id": "18023622065863920", "text": "compare with Laya also.", "timestamp": 1790651923, "like_count": 2}], "webpage_url": "https://www.instagram.com/reel/Dd2UVU_sVNH/", "original_url": "https://www.instagram.com/reel/Dd2UVU_sVNH/", "webpage_url_basename": "Dd2UVU_sVNH", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "playlist": null, "playlist_index": null, "thumbnail": "https://scontent-sjc6-1.cdninstagram.com/v/t51.71878-15/829320101_1068112049165180_6210808989764728902_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=107&ig_cache_key=Mzk5NjQ3MTE0NTkyMDU0OTcwMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=ICx3L9avvSAQ7kNv