{"id": "DeuMK6FJhoc", "title": "Video by petridish.games", "description": "MCPs, prebuilt engines, meshy, blender... its all a waste of time. Build the tools you need directly with your agents. Granted, I work around the limitations in terms of what styles work, but if you want something more realistic I don't think generative models are the way to go (for now). I think eventually tools like Meshy will be good enough to not make slop games, but for now I just see them as slop tbh.\n\n#aitools #accelerationist #vibecode #indiedev #claudecode", "channel": "petridish.games", "uploader_id": "34367021987", "uploader": "Petri Dish Games", "timestamp": 1792511519, "like_count": 54, "comment_count": 32, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.instagram.com/"}, "formats": [{"format_id": "dash-28079019621772630a", "manifest_url": null, "ext": "m4a", "width": null, "height": null, "tbr": 86.324, "asr": 44100, "fps": null, "language": null, "format_note": "DASH audio", "filesize": null, "container": "m4a_dash", "vcodec": "none", "acodec": "mp4a.40.5", "dynamic_range": null, "url": "https://scontent-sjc6-1.cdninstagram.com/o1/v/t2/f2/m78/AQObx4lsJ-rW94jBQypATpyBy19x9ofoQCx19UY4midEGhIYxFntvX1tlkuLglPDVBZXNGiMt2Cj7RdLDzTvPmX8N8T0O5SmmK8ecNg.mp4?_nc_cat=108&_nc_sid=9ca052&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_ohc=RLW0ficX8AAQ7kNvwEhM2jb&%3D&ccb=17-1&_nc_gid=nfZx320hN2kfL387ha0hXg&_nc_ss=79689&_nc_zt=28&oh=00_AQQzjW66zkgLP57xJfk5nFYPi-5LC7TV2sBADvKYzCpdkQ&oe=6AE490C9", "manifest_stream_number": 0, "is_dash_periods": true, "protocol": "https", "audio_ext": "m4a", "video_ext": "none", "vbr": 0, "abr": 86.324, "resolution": "audio only", "aspect_ratio": null, "filesize_approx": null, "http_headers": {"User-Age