key=Mzg5MDYyMzg4MTU5NjYwNzgxMjE3OTczOTIwNjU4MDEzODQw.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=BqJyA7nor6IQ7kNvwF3zvua&_nc_oc=AdrvuJANXwtZx9kq-YqxTi4TM7G0vKnx5ZOFMMGDtQn6oBNWxkcF0xbdIAg3cYKwRZM&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=Dp1azuOO4GP2ux0KStLG6g&_nc_ss=79689&oh=00_AQRaXpgBPO99GfURCAonNJg8UADZPIwPzwLD6GjrX9OzoA&oe=6AE87117", "width": 1080, "height": 1080, "id": "11", "resolution": "1080x1080"}, {"url": "https://scontent-sjc6-1.cdninstagram.com/v/t51.82787-15/684620935_17973920661013840_5147958860545632885_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=Mzg5MDYyMzg4MTU5NjYwNzgxMjE3OTczOTIwNjU4MDEzODQw.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=BqJyA7nor6IQ7kNvwF3zvua&_nc_oc=AdrvuJANXwtZx9kq-YqxTi4TM7G0vKnx5ZOFMMGDtQn6oBNWxkcF0xbdIAg3cYKwRZM&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=Dp1azuOO4GP2ux0KStLG6g&_nc_ss=79689&oh=00_AQTaGiROXc_EPPwCH-4G3XXjdINIZ9gkk6yz-zzlzO316w&oe=6AE87117", "width": 1080, "height": 1920, "id": "12", "resolution": "1080x1920"}], "comments": [{"author": "cnbrk.hncn", "author_id": "32234492021", "id": "18108167777363354", "text": "Why is a Radiohead guy carrying a sword? \ud83d\ude02 looks like an identity crisis to me.", "timestamp": 1792123701, "like_count": 0}, {"author": "lanedefensegame", "author_id": "23815952767", "id": "18110999807232292", "text": "The motion feels so lively\u2014great example of how small animation details can make a character feel much more alive. The before-and-after is especially satisfying.", "timestamp": 1791528306, "like_count": 0}, {"author": "secretlyminos", "author_id": "79743881951", "id": "18180714649424877", "text": "Frame by frame? King crimson referenced?", "timestamp": 1787998869, "like_count": 3}, {"author": "org.done", "author_id": "44704919298", "id": "18116541377291817", "text": "\"one of the hardest\" meanwhile coding:", "timestamp": 1786194401, "like_count": 26}, {"author": "isvyeh", "author_id": "46096789259", "id": "18116276582302040", "text": "You can first create a sprite of the character\u2019s body parts, with each part separated (all inside one image). Then you can import the character into Smack Studio and define the bones. After that, you\u2019ll have a roughly 3D model based on your pixel art character, which you can animate in different ways and export as a sprite sheet.\nSometimes, for simple things, this method is available and it\u2019s much easier than animating frame by frame. It gets the job done. Try it", "timestamp": 1785935356, "like_count": 1}, {"author": "surprisinglyinaccurate", "author_id": "75940714762", "id": "17910271398440686", "text": "Thank you so much!", "timestamp": 1785161004, "like_count": 0}, {"author": "esyengaming", "author_id": "17208070604", "id": "18133205539614688", "text": "This is so helpful! \ud83d\ude0d", "timestamp": 1784903193, "like_count": 0}, {"author": "adrianhway", "author_id": "43730015", "id": "18025017677666283", "text": "Nice \ud83d\udd25", "timestamp": 1782416277, "like_count": 1}, {"author": "korpe0h", "author_id": "72647683060", "id": "18057636041748744", "text": "What do you use?", "timestamp": 1782389284, "like_count": 0}, {"author": "khael.art", "author_id": "36412922821", "id": "18085103450432627", "text": "Really cool, thanks for sharing ;)", "timestamp": 1782337274, "like_count": 0}, {"author": "gustavcarv09", "author_id": "74738221205", "id": "18102883757164564", "text": "@marihelo1019 AT\u00c9 AQ MANO, ISADORA", "timestamp": 1782335210, "like_count": 0}, {"author": "j.w.i.d", "author_id": "75687509512", "id": "18610065415048977", "text": "Rain world us a 2d pixelated game and has procedurally generated animations", "timestamp": 1781537493, "like_count": 1}, {"author": "roshancodesgodot", "author_id": "25134966334", "id": "17914380219200528", "text": "Not hating but 3d is harder even tho the computer does most of it.  the computer decides to take the wierdest path instead of easiest and takes hours trying to fix it instead of drawing", "timestamp": 1781215957, "like_count": 8}, {"author": "axiomprimegame", "author_id": "22227849755", "id": "18062543279437935", "text": "Nice walkthrough for saving time. Very glad for these tips which we can use for our game.", "timestamp": 1778792730, "like_count": 1}], "webpage_url": "https://www.instagram.com/reel/DX-Rc6RN51E/", "original_url": "https://www.instagram.com/reel/DX-Rc6RN51E/", "webpage_url_basename": "DX-Rc6RN51E", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "playlist": null, "playlist_index": null, "thumbnail": "https://scontent-sjc6-1.cdninstagram.com/v/t51.82787-15/684620935_17973920661013840_5147958860545632885_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=Mzg5MDYyMzg4MTU5NjYwNzgxMjE3OTczOTIwNjU4MDEzODQw.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=BqJyA7nor6IQ7kNvwF3zvua&_nc_oc=AdrvuJANXwtZx9kq-YqxTi4TM7G0vKnx5ZOFMMGDtQn6oBNWxkcF0xbdIAg3cYKwRZM&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=Dp1azuOO4GP2ux0KStLG6g&_nc_ss=79689&oh=00_AQTaGiROXc_EPPwCH-4G3XXjdINIZ9gkk6yz-zzlzO316w&oe=6AE87117", "display_id": "DX-Rc6RN51E", "fulltitle": "Video by inboundshovel", "upload_date": "20260505", "release_year": null, "requested_subtitles": null, "_has_drm": null, "epoch": 1793243571, "url": "https://scontent-sjc6-1.cdninstagram.com/o1/v/t2/f2/m86/AQNFkFAHnPcWx7DQdWbTWUGBcWMj-nT4SZxKp5tUXxSLaCNyG5lMJRyCGufXA5Mujw0fvC-aipCP7d-l7bQg0gbJWaulNVXkFZGkG-4.mp4?_nc_cat=100&_nc_sid=5e9851&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_ohc=WX--ny0BqMIQ7kNvwH0G-7x&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTUxNTg3NTkwMDMyNzcyMCwiYXNzZXRfYWdlX2RheXM