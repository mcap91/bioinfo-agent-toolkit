x1920"}], "comments": [{"author": "psilosamples_info", "author_id": "22514571085", "id": "18118720984947165", "text": "\ud83d\udd25\ud83d\udd25\ud83d\udd25", "timestamp": 1791822164, "like_count": 0}, {"author": "landonoris234", "author_id": "78001813034", "id": "18132150904663294", "text": "\uc624\ud508\uc18c\uc2a4\ub77c\uace0 \ubd80\ub97c \uc218\uac00 \uc788\ub098 \uc774\uc81c\ub294....", "timestamp": 1791813328, "like_count": 0}, {"author": "kwonkyu_park", "author_id": "77571887557", "id": "18143258863720199", "text": "YOLO!! My first experience on ml models", "timestamp": 1791708001, "like_count": 0}, {"author": "telecarlster", "author_id": "4464646811", "id": "18633472675022079", "text": "Ghost 0.76", "timestamp": 1791505727, "like_count": 0}, {"author": "mo_chahadeh", "author_id": "5338505582", "id": "18107998267924440", "text": "@levwad elite reference", "timestamp": 1791392624, "like_count": 0}, {"author": "liftingcoder", "author_id": "78037958915", "id": "17847331236697273", "text": "Why use this over OpenCV or FastSAM?", "timestamp": 1791316890, "like_count": 2}, {"author": "zied_fat", "author_id": "1806335168", "id": "18124782293514617", "text": "@save.to.list", "timestamp": 1791316758, "like_count": 1}, {"author": "saileshpattnaik", "author_id": "1499244007", "id": "17964423435198003", "text": "\ud83d\ude4c", "timestamp": 1791285449, "like_count": 1}, {"author": "levwad", "author_id": "3522899", "id": "18124272511931466", "text": "not hotdog", "timestamp": 1791284000, "like_count": 7}, {"author": "zeroelevenzero", "author_id": "14521220001", "id": "17992113453023061", "text": "If one researches stuff like this as a postgraduate in IT are you pro-mass-surveillance already or does one delude oneself that it's \"merely science\"?", "timestamp": 1791269207, "like_count": 16}, {"author": "artislife3127", "author_id": "76540528728", "id": "18115805522074577", "text": "Can't use it commercially, ultralytics license forces you to make your entire system open source if you would like to use it for free commercially, and yes they do offer paid version as well, though this is only for newer models, can use the old models commercially, but they have poor performance. Faced this problem in our company project, anyways we moved on to our own model, and yes it performs better than yolo, built upon open sourced model rtdtr", "timestamp": 1791268648, "like_count": 42}, {"author": "boutrip", "author_id": "40785019", "id": "18127346392797763", "text": "do i need a gpu running it?", "timestamp": 1791265778, "like_count": 2}, {"author": "sasakee___", "author_id": "4785974839", "id": "18110476964332320", "text": "@akhdrzki", "timestamp": 1791262437, "like_count": 0}], "webpage_url": "https://www.instagram.com/reel/DeI8uRMhi3G/", "original_url": "https://www.instagram.com/reel/DeI8uRMhi3G/", "webpage_url_basename": "DeI8uRMhi3G", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "playlist": null, "playlist_index": null, "thumbnail": "https://scontent-sjc3-1.cdninstagram.com/v/t51.82787-15/833059092_18003419406006966_6730503057497669776_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=NDAwMTcxNTMzMTI2OTAxMjkzNA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=CVyHtIncs6IQ7kNvwEZJCJ5&_nc_oc=AdopISKeTKLq5KTAiUIJLGrXe0G7MYFgIQej0gKaiKsPVExwRYiYenv6aknmUXdO3pw&_nc_zt=23&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_gid=f0fVK8h38WdbWDibeGOG8A&_nc_ss=79689&oh=00_AQP8nbjXNzq6A8cHHoG3fjIOV8r90MzsR_xXqhtnk_EHwA&oe=6AE62D16", "display_id": "DeI8uRMhi3G", "fulltitle": "Video by index.opensource", "upload_date": "20261006", "release_year": null, "requested_subtitles": null, "_has_drm": null, "epoch": 1793081640, "url": "https://scontent-sjc6-1.cdninstagram.com/o1/v/t2/f2/m86/AQPuaXc_5YEw_W2CNDtVR1v3AUHN4tMgJ0TW600CiY2WZKhX1YHxz6q5LDgMs3Qv0UbSyhBzqhwaKBJAgeS3Iz0V22ez5gGi5euw25k.mp4?_nc_cat=109&_nc_sid=5e9851&_n