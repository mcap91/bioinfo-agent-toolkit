y5r59NE0V6YQ&oe=6AE89FF4", "width": 640, "height": 640, "id": "8", "resolution": "640x640"}, {"url": "https://scontent-sjc6-1.cdninstagram.com/v/t51.71878-15/852558663_1917456735887563_7712055918254041606_n.jpg?stp=c0.248.640.640a_dst-jpg_e15_s640x639_tt6&_nc_cat=111&ig_cache_key=NDAxMTU0MTQxODQ0Mjg0MTQ3ODE4MTA0Nzg1NDc1MjM0NjQx.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=Gd2IsHPC8cEQ7kNvwFgXgKB&_nc_oc=AdrGOu5cSts_PFlylGnGJavzZuQLL3SmnWeFi939DWvONiv6F5ZlUeP1U9HafcOX8EA&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=PUTmbBP8cLx1c5KHUOIpQQ&_nc_ss=79689&oh=00_AQQd5P0akr1E7Eedt__CQhP1s5vquP-HFQy5r59NE0V6YQ&oe=6AE89FF4", "width": 640, "height": 640, "id": "9", "resolution": "640x640"}, {"url": "https://scontent-sjc6-1.cdninstagram.com/v/t51.71878-15/852558663_1917456735887563_7712055918254041606_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=111&ig_cache_key=NDAxMTU0MTQxODQ0Mjg0MTQ3ODE4MTA0Nzg1NDc1MjM0NjQx.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=Gd2IsHPC8cEQ7kNvwFgXgKB&_nc_oc=AdrGOu5cSts_PFlylGnGJavzZuQLL3SmnWeFi939DWvONiv6F5ZlUeP1U9HafcOX8EA&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=PUTmbBP8cLx1c5KHUOIpQQ&_nc_ss=79689&oh=00_AQTuTEABaQDUAJvDNef5CUBBDp18cPySRV1NkQSpbo7sLg&oe=6AE89FF4", "width": 640, "height": 1136, "id": "10", "resolution": "640x1136"}], "comments": [{"author": "pit21_programmer", "author_id": "23550924648", "id": "18648265042007725", "text": "It's intresting to see how each game engine do the same thing in different ways, it's cool", "timestamp": 1792970499, "like_count": 1}, {"author": "ludo.ai", "author_id": "47525018380", "id": "17910930822484131", "text": "Keeping health, damage on touch and xp drops as separate small pieces is why 76 enemies can share one health component. It cuts a new enemy down to mostly animation work.", "timestamp": 1792872040, "like_count": 1}, {"author": "onegameadaynet", "author_id": "61019507769", "id": "18102681002288851", "text": "Component-based enemies are such a smart setup. 76 enemies on one health component is a great stat! Do bosses get their own components too, or mostly bigger numbers and new animations?", "timestamp": 1792817859, "like_count": 0}, {"author": "lanedefensegame", "author_id": "23815952767", "id": "17970889392168140", "text": "We\u2019re building Lane Defense in Godot too, so this reusable-health breakdown hits close to home. The boss-exception question in the comments is a useful edge case\u2014would you handle no-knockback with a separate component rather than a special-case flag?", "timestamp": 1792586993, "like_count": 3}, {"author": "kurenaisamuraigame", "author_id": "20589376743", "id": "18131892472751655", "text": "76 enemies on one health component is honestly the dream. what do you do when one needs something special, like a boss that cant be knocked back? extra component or just a flag on the old one?", "timestamp": 1792581536, "like_count": 1}, {"author": "artopyos", "author_id": "54981030519", "id": "17875563624588358", "text": "How do your node components work with data / resources? How do your enemies stats get distributed for example?", "timestamp": 1792518877, "like_count": 2}, {"author": "1997alijavad", "author_id": "2373767350", "id": "18136941562651372", "text": "\ud83d\ude4c", "timestamp": 1792481264, "like_count": 1}, {"author": "poopidypappidi", "author_id": "9905657104", "id": "17875876158587867", "text": "Are there scriptable objects in Gadot ?", "timestamp": 1792475206, "like_count": 0}, {"author": "razor.4eg", "author_id": "12021814454", "id": "18112336328132593", "text": "It\u2019s a simple SoA in ECS model. You better tell me how you managing active buckets of that systems)", "timestamp": 1792462696, "like_count": 0}, {"author": "onweek066", "author_id": "78628394645", "id": "18028136666702206", "text": "Yes, i've done that for inventory, npcs, mobs and etc have inventory too, a equipaments inventory too", "timestamp": 1792460146, "like_count": 1}, {"author": "severaljamesherr", "author_id": "65635812139", "id": "17863977696697048", "text": "\ud83d\udd25\ud83d\udd25\ud83d\udd25", "timestamp": 1792453566, "like_count": 0}, {"author": "amongtheherdgame", "author_id": "26045650718", "id": "17979252678128751", "text": "Oh, this looks amazing, the animations are fantastic.", "timestamp": 1792445280, "like_count": 10}, {"author": "cnbrk.hncn", "author_id": "32234492021", "id": "17965195173211632", "text": "Like scriptable objects in Unity, Godot has its own way. I'm intrigued to try Godot on my next game. Thanks for sharing your roadblocks brother; I wish you a great success \u2764\ufe0f\ud83d\udc4f\ud83c\udffb", "timestamp": 1792440776, "like_count": 6}], "webpage_url": "https://www.instagram.com/reel/Der26qADV2G/", "original_url": "https://www.instagram.com/reel/Der26qADV2G/", "webpage_url_basename": "Der26qADV2G", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "playlist": null, "playlist_index": null, "thumbnail": "https://scontent-sjc6-1.cdninstagram.com/v/t51.71878-15/852558663_1917456735887563_7712055918254041606_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=111&ig_cache_key=NDAxMTU0MTQxODQ0Mjg0MTQ3ODE4MTA0Nzg1NDc1MjM0NjQx.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=Gd2IsHPC8cEQ7kNvwFgXgKB&_nc_oc=AdrGOu5cSts_PFlylGnGJavzZuQLL3SmnWeFi939DWvONiv6F5ZlUeP1U9HafcOX8EA&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=PUTmbBP8cLx1c5KHUOIpQQ&_nc_ss=79689&oh=00_AQTuTEABaQDUAJvDNef5CUBBDp18cPySRV1NkQSpbo7sLg&oe=6AE89FF4", "display_id": "Der26qADV2G", "fulltitle": "Video by capyember", "upload_date": "20261019", "release_year": null, "requested_subtitles": null, "_has_drm": null, "epoch": 1793243509, "url": "https://scontent-sjc3-1.cdninstagram.com/o1/v/t2/f2/m86/AQOpeq1UrZJgFFVMCpo