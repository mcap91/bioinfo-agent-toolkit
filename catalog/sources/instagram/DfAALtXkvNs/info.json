author": "ali_s.c.hd", "author_id": "1531668127", "id": "18074204927756645", "text": "Rogue like game games dont do this these days tho", "timestamp": 1793184109, "like_count": 4}, {"author": "greaseman8638", "author_id": "39291358339", "id": "18350335417254559", "text": "Bro made the first roguelike", "timestamp": 1793173655, "like_count": 48}, {"author": "malteeselover", "author_id": "49707019961", "id": "18108839900575593", "text": "net-hack was good...", "timestamp": 1793152130, "like_count": 0}, {"author": "theconnorhertz", "author_id": "468792842", "id": "18106004345132980", "text": "Take a look at Enter the Gungeon! Could deep dive on the dungeons or the guns!", "timestamp": 1793150938, "like_count": 2}, {"author": "deeznutmuncha", "author_id": "43014648112", "id": "18138273979634800", "text": "Love actual roguelikes, I wish they had more recognition. Dcss is a personal favorite of mine", "timestamp": 1793147532, "like_count": 1}, {"author": "nathan_p_23", "author_id": "325138903", "id": "18649397170048559", "text": "There's so so so many ways to do random dungeon generation. You have graph theory approaches (several), dfs/bfs approaches, mathematical function modeling like sine waves, and many many more. This particular method is a random spanning tree approach with some additional tunneling at the end", "timestamp": 1793138649, "like_count": 2}, {"author": "katalystisthename", "author_id": "699588681", "id": "18169097962470985", "text": "This account is criminally underrated. Love these videos, they're presented so well.", "timestamp": 1793117147, "like_count": 4}, {"author": "goodadampunstaken", "author_id": "38989638343", "id": "17988859562881333", "text": "If only there were more games that were like Rogue\u2026 some sort of\u2026 Rogue-likes\u2026.", "timestamp": 1793113491, "like_count": 276}, {"author": "seymoursoldit", "author_id": "56779876193", "id": "18086351507321796", "text": "Really hope this page blows up! Love the content!", "timestamp": 1793109296, "like_count": 5}], "webpage_url": "https://www.instagram.com/reel/DfAALtXkvNs/", "original_url": "https://www.instagram.com/reel/DfAALtXkvNs/", "webpage_url_basename": "DfAALtXkvNs", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "playlist": null, "playlist_index": null, "thumbnail": "https://scontent-sjc3-1.cdninstagram.com/v/t51.82787-15/870141267_18129036811793204_4910067235330794838_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=103&ig_cache_key=NDAxNzIxMTY3MjI0MjYxNTE0ODE4MTI5MDM2ODA4NzkzMjA0.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=9tX8rPBaqygQ7kNvwFcWnyB&_nc_oc=AdqD_jvejS3XTtmZeth2a9qwrMl02R4t8LCYoVFa6_ZN5FGEkczm0BL0zdHhBwk4qOU&_nc_zt=23&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_gid=gt1IbTZ69-U6pE4XNrXOvA&_nc_ss=79689&oh=00_AQTVdlAmmcNl398jkurFrHLXEgYakIOq9O3Y1h3yMeVYgQ&oe=6AE87BFD", "display_id": "DfAALtXkvNs", "fulltitle": "Video by howitspawns", "upload_date": "20261027", "release_year": null, "requested_subtitles": null, "_has_drm": null, "epoch": 1793243727, "url": "https://scontent-sjc6-1.cdninstagram.com/o1/v/t2/f2/m86/AQPpUirxMeoH-QyCyfUJQUGxTv0FlhYdriXZxYUWG_ZC8Q3N7nk9K_nG6w7vJbbgACw7emWQTl2XVDOyCkHAPg-gZQxB4SKuadeIZJM.mp4?_nc_cat=107&_nc_sid=5e9851&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_ohc=4uPfHSI9Q_UQ7kNvwE024qq&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTgxMjkwMzYxNDU3OTMyMDQsImFzc2V0X2FnZV9kYXlzIjoxLCJ2aV91c2VjYXNlX2lkIjoxMDA5OSwiZHVyYXRpb25fcyI6ODAsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ%3D%3D&ccb=17-1&vs=7c15d72aad8bf9b3&_nc_&_nc_gid=gt1IbTZ69-U6pE4XNrXOvA&_nc_ss=79689&_nc_zt=28&oh=00_AQREh--FXBnd3n4HHuZqEQxeNszAkBEOdFFRNnSCcpKa4w&oe=6AE4AD90", "protocol": "https", "ext": "mp4", "video_ext": "mp4", "audio_ext": "none", "vbr": null, "abr": null, "tbr": null, "resolution": null, "dynamic_range": "SDR", "aspect_ratio": null, "f