{"id": "DfAKyLiM9Or", "title": "Video by stalwartfox.games", "description": "I hate tilesets. So my map doesn\u2019t have one. \ud83d\uddfa\ufe0f\n\nEdges, corners, inner corners, 47 pieces for every pair of terrains, all tiling with each other. I drew zero. Every tile is one number, and one shader draws the rest: coasts, grass blades, foam, roads, fields, snow.\n\nValdrin is a medieval kingdom builder, wishlist on Steam (link in bio).\n\n#gamedev #indiedev #pixelart #shaders #steamgames", "channel": "stalwartfox.games", "uploader_id": "24421886150", "uploader": "Stalwart Fox", "timestamp": 1793114615, "like_count": 7669, "comment_count": 95, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.instagram.com/"}, "formats": [{"format_id": "dash-2938215989871332a", "manifest_url": null, "ext": "m4a", "width": null, "height": null, "tbr": 42.104, "asr": 44100, "fps": null, "language": null, "format_note": "DASH audio", "filesize": null, "container": "m4a_dash", "vcodec": "none", "acodec": "mp4a.40.5", "dynamic_range": null, "url": "https://scontent-sjc3-1.cdninstagram.com/o1/v/t2/f2/m78/AQOwiZFBH8AM85T-BAltm5rvca1azKBt9Ii7S-Gqwgh3e4lhQKmx_j7FG5EAdv0WMYqJmKjh_QSx2Pa2xV-e19hyBp3fMfbwoinqFSk.mp4?_nc_cat=106&_nc_sid=9ca052&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_ohc=r3AIgt2Oe_MQ7kNvwHkpclQ&&ccb=17-1&_nc_gid=smSZOpqp0a_4c6NcXD46Dg&_nc_ss=79689&_nc_zt=28&oh=00_AQQhjPAgiOIi6x84cEZwR-NWvp8RCB3dA735a3zHWjHavg&oe=6AE47B3F", "manifest_stream_number": 0, "is_dash_periods": true, "protocol": "https", "audio_ext": "m4a", "video_ext": "none", "vbr": 0, "abr": 42.104, "resolution": "audio only", "aspect_ratio": null, "filesize_approx": null, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKi