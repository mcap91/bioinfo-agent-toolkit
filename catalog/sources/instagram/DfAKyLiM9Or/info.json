5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjkwMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=6OKmy7KpIM8Q7kNvwEO5_Xs&_nc_oc=Ado5mkQaiLz9u6ZsfVLn2qW2-bJuz_W5sT6utPfSQlhxX7gAjYEJ3c5R_Jho5FdY2GA&_nc_zt=23&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_gid=smSZOpqp0a_4c6NcXD46Dg&_nc_ss=79689&oh=00_AQTCask90w3KJ0iIpjDUO7ffQd70mNTxwlTlwadExDHxUw&oe=6AE8A1CA", "width": 750, "height": 750, "id": "10", "resolution": "750x750"}, {"url": "https://scontent-sjc3-1.cdninstagram.com/v/t51.82787-15/864654727_2938216909871240_2454864372048419566_n.jpg?stp=c0.350.900.900a_dst-jpg_e15_s900x900_tt6&_nc_cat=105&ig_cache_key=NDAxNzI1ODI5NjQzODQxMjIwMzI5MzgyMTY4OTk4NzEyNDE%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjkwMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=6OKmy7KpIM8Q7kNvwEO5_Xs&_nc_oc=Ado5mkQaiLz9u6ZsfVLn2qW2-bJuz_W5sT6utPfSQlhxX7gAjYEJ3c5R_Jho5FdY2GA&_nc_zt=23&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_gid=smSZOpqp0a_4c6NcXD46Dg&_nc_ss=79689&oh=00_AQT6w_O0Tgd5pk3AZDjc8mWT1pSgz2kqj7A1CtaTVpxlrQ&oe=6AE8A1CA", "width": 900, "height": 900, "id": "11", "resolution": "900x900"}, {"url": "https://scontent-sjc3-1.cdninstagram.com/v/t51.82787-15/864654727_2938216909871240_2454864372048419566_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=105&ig_cache_key=NDAxNzI1ODI5NjQzODQxMjIwMzI5MzgyMTY4OTk4NzEyNDE%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjkwMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=6OKmy7KpIM8Q7kNvwEO5_Xs&_nc_oc=Ado5mkQaiLz9u6ZsfVLn2qW2-bJuz_W5sT6utPfSQlhxX7gAjYEJ3c5R_Jho5FdY2GA&_nc_zt=23&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_gid=smSZOpqp0a_4c6NcXD46Dg&_nc_ss=79689&oh=00_AQTL9sgAAD3hC6G9oOdkM0cY6nf2xRbMzPox5cdV_WFIAA&oe=6AE8A1CA", "width": 900, "height": 1600, "id": "12", "resolution": "900x1600"}], "comments": [{"author": "victornutty.barlac", "author_id": "27470201242", "id": "18106132205316406", "text": "Dynamic tileset then, not writing the results, but writing the rules that lead to them", "timestamp": 1793227684, "like_count": 0}, {"author": "ozgurdenizkaragoz", "author_id": "7809280266", "id": "17981671773131041", "text": "I am going to steal your idea and never credit you \ud83d\ude4c", "timestamp": 1793222518, "like_count": 0}, {"author": "kubaxius", "author_id": "4855238004", "id": "18376012114245857", "text": "Technically, these are still tiles, just without tile map \ud83e\udd13 Still great, I love shaders", "timestamp": 1793209671, "like_count": 0}, {"author": "woz_in_nz", "author_id": "5712025178", "id": "18121055245757052", "text": "So, a tileset then", "timestamp": 1793207614, "like_count": 0}, {"author": "vfm_pix", "author_id": "27482839338", "id": "18108949403354587", "text": "One number per tile plus a shader instead of 47 hand-drawn transitions is such a clean solution. Does it handle three terrains meeting at a single corner?", "timestamp": 1793203882, "like_count": 0}, {"author": "a_dark_cave", "author_id": "78523092830", "id": "18131802646856288", "text": "Drawing the whole map from one number per tile and a single shader keeps the terrain data small and easy to change. A Dark Cave, my village-building survival game, goes the other way and shows almost everything as text, out now on Steam with a free demo.", "timestamp": 1793203771, "like_count": 0}, {"author": "paramonium", "author_id": "6551024", "id": "18146188270596261", "text": "This is really efficient and clever", "timestamp": 1793203504, "like_count": 0}, {"author": "smuzani", "author_id": "56085812", "id": "17922292464446265", "text": "Truly the spirit of an artist", "timestamp": 1793198113, "like_count": 0}, {"author": "luismg.exe", "author_id": "1641796694", "id": "18108596939354688", "text": "So tilesets, but offset so it's less efficient and takes up more memory", "timestamp": 1793194774, "like_count": 0}, {"author": "pure_ez", "author_id": "3565340210", "id": "18116769620036658", "text": "You say you don\u2019t draw any tiles, how do you go about making the likes of the grass or cobbles stone path? Is it just a bunch of coloured and masked noise? Looks awesome, is there any documentation anywhere that I could read up on how to get such a convincing pixel art shader effect?", "timestamp": 1793194262, "like_count": 0}, {"author": "abelmigo", "author_id": "496209097", "id": "18111097268183279", "text": "Nice!!\ud83d\udd25", "timestamp": 1793193296, "like_count": 0}, {"author": "matt.wyndhammer", "author_id": "2097236292", "id": "18146184583564744", "text": "Why did you have an ai voiceover", "timestamp": 1793192783, "like_count": 0}, {"author": "cryotato", "author_id": "4775177574", "id": "18039207650892977", "text": "llm ahh script", "timestamp": 1793191999, "like_count": 0}, {"author": "endertheduck", "author_id": "6274361013", "id": "18134199910738462", "text": "I\u2019m interested, how do you create a map? Do you just put numbers into a file or did you make an editor", "timestamp": 1793191222, "like_count": 0}], "webpage_url": "https://www.instagram.com/reel/DfAKyLiM9Or/", "original_url": "https://www.instagram.com/reel/DfAKyLiM9Or/", "webpage_url_basename": "DfAKyLiM9Or", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "playlist": null, "playlist_index": null, "thumbnail": "https://scontent-sjc3-1.cdninstagram.com/v/t51.82787-15/864654727_2938216909871240_2454864372048419566_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=105&ig_cache_key=NDAxNzI1ODI5NjQzODQxMjIwMzI5MzgyMTY4OTk4NzEyNDE%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjkwMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=6OKmy7KpIM8Q7kNvwEO5_Xs&_nc_oc=Ado5mkQaiLz9u6ZsfVLn2qW2-bJuz_W5sT6utPfSQlhxX7gAjYEJ3c5R_Jho5FdY2GA&_nc_zt=23&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_gid=smSZOpqp0a_4c6NcXD46Dg&_nc_ss=79689&oh=00_AQTL9sgAAD3hC6G9oOdkM0cY6nf2xRbMzPox5cdV_WFIAA&oe=6AE8A1CA", "display_id": "DfAKyLiM9Or", "fulltitle": "Video by stalwartfox.games", "upload_date": "20261027", "release_year": null, "requested