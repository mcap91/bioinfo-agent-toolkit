{"id": "DfAmYQQDsNW", "title": "Video by mattmurphyai", "description": "Your team wants to fine-tune an AI model on your company documents. \n\nSo you will pay to teach it facts it will still get wrong. Tuning teaches a model how to behave, not what you know. One. Facts go in documents the model reads when it answers. Two. Tune for behavior with a few hundred clean, approved examples. Three. Tune an open model you own, like Qwen 3.8 27B on one workstation, and test it against the original. \n\nKnowledge in the folder. Behavior in the model. Both in your building.\n\n-MM\n\n#ai #openweights #finetuning #operators #aidirectedengineering", "channel": "mattmurphyai", "uploader_id": "57902705950", "uploader": "Matt Murphy", "timestamp": 1793129035, "like_count": 140, "comment_count": 7, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.instagram.com/"}, "formats": [{"format_id": "dash-18025928609929951a", "manifest_url": null, "ext": "m4a", "width": null, "height": null, "tbr": 51.63, "asr": 48000, "fps": null, "language": null, "format_note": "DASH audio", "filesize": null, "container": "m4a_dash", "vcodec": "none", "acodec": "mp4a.40.5", "dynamic_range": null, "url": "https://scontent-sjc3-1.cdninstagram.com/o1/v/t2/f2/m78/AQPJCMSs3rXrRlWD6YrkTDi2JukP1KzO2yk1xpYtg4VF4usVdAUa-_L66QJmIixBrYDhaMXIzv8S61Y-ZbQmD8lpSU1NqKX4g-cEWAo.mp4?_nc_cat=106&_nc_sid=9ca052&_nc_ht=scontent-sjc3-1.cdninstagram.com&_nc_ohc=r9QHVq5nRZsQ7kNvwGmKZi1&%3D&ccb=17-1&_nc_gid=3Kl2_B-RPgg4rh1RbeZDgA&_nc_ss=79689&_nc_zt=28&oh=00_AQSJ45asnqXEjj9x-y6KUI6aZ8oMAprUFBCmiIraYMmOIA&oe=6AE48523", "manifest_stream_number": 0, "is_dash_periods": true, "protocol": "https", "audio_ext": "m4a", "video_ext": "none", "vbr": 0, "abr": 51.63, "resolution": "