#!/bin/bash
if git diff --name-only HEAD@{1} HEAD | grep -q '^catalog/entries/'; then
  echo "catalog entries changed — rebuilding vectors..."
  repo_root="$(git rev-parse --show-toplevel)"
  venv_python="$repo_root/packages/catalog-embedder/.venv/bin/python"
  if [ -x "$venv_python" ]; then
    "$venv_python" -m catalog_embedder build --dir "$repo_root"
  else
    echo "catalog-embedder venv not found — skipping vector rebuild"
  fi
fi
